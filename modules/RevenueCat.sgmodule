#!name=RevenueCat
#!desc=AppTesters RevenueCat rule for Shadowrocket

[Header Rewrite]
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del X-RevenueCat-ETag
http-request ^https?:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/?(.*?)*$) header-del x-revenuecat-etag

[Script]
RevenueCat = type=http-response,pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$),requires-body=true,max-size=0,script-path=https://apptesters.org/egern/AutoRC.js

[MITM]
hostname = %APPEND% api.revenuecat.com
